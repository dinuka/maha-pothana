    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.8.5",
    "turbo": "^2.10.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=18"
  }
}
